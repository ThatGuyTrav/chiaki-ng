diff --git a/.github/workflows/build-msys2-tracy.yml b/.github/workflows/build-msys2-tracy.yml
new file mode 100644
index 0000000..b9ee2f7
--- /dev/null
+++ b/.github/workflows/build-msys2-tracy.yml
@@ -0,0 +1,150 @@
+name: Build chiaki-ng msys2 x64 Windows (Tracy profiling build)
+
+# Debug/profiling build, not part of the normal release pipeline: builds
+# chiaki-ng under MSYS2/mingw64 with -DCHIAKI_ENABLE_TRACY=ON so the
+# resulting chiaki.exe streams zone/frame data to a connected Tracy
+# profiler (https://github.com/wolfpld/tracy), and also downloads the
+# matching prebuilt Tracy profiler GUI (tracy-profiler.exe) so the
+# artifact is ready to use with no separate download step.
+#
+# The client library version is pinned in the top-level CMakeLists.txt
+# (currently v0.14.1) and MUST match tracy_profiler_zip's version below --
+# Tracy refuses to connect client/server on a protocol version mismatch.
+on:
+  workflow_dispatch:
+    inputs:
+      libplacebo_version:
+        description: "libplacebo git tag to build"
+        required: false
+        default: "3be579e6c7f6b421d9ac3ab4860edc437c50b3eb"
+      tracy_profiler_zip:
+        description: "Direct URL to the prebuilt Windows Tracy profiler zip (version must match the GIT_TAG pinned in CMakeLists.txt)"
+        required: false
+        default: "https://github.com/wolfpld/tracy/releases/download/v0.14.1/windows-0.14.1.zip"
+
+jobs:
+  build-windows_x64-msys2-tracy:
+    name: Build windows msys2 version (Tracy enabled)
+    runs-on: windows-latest
+    defaults:
+      run:
+        shell: msys2 {0}
+    steps:
+      - name: Disable autocrlf
+        shell: pwsh
+        run: |
+          git config --global core.autocrlf false
+          git config --global core.eol lf
+      - uses: actions/checkout@v4
+        with:
+          submodules: recursive
+      - uses: msys2/setup-msys2@v2
+        with:
+          msystem: mingw64
+          update: true
+          install: git
+          pacboy: >-
+            ca-certificates:p
+            cc:p
+            cmake:p
+            curl:p
+            diffutils:p
+            fast_float:p
+            fftw:p
+            hidapi:p
+            json-c:p
+            libevent:p
+            lcms2:p
+            libdovi:p
+            meson:p
+            miniupnpc:p
+            gcc:p
+            nasm:p
+            ninja:p
+            openssl:p
+            opus:p
+            pkgconf:p
+            protobuf:p
+            python:p
+            python-psutil:p
+            python-glad:p
+            python-jinja:p
+            python-pip:p
+            qt6-base:p
+            qt6-declarative:p
+            qt6-svg:p
+            shaderc:p
+            speexdsp:p
+            spirv-cross:p
+            vulkan:p
+            vulkan-headers:p
+
+      - name: Install python protobuf and zip
+        run: |
+          pip install protobuf
+          pacman -S git make unzip zip --noconfirm
+
+      - name: Build libplacebo
+        run: |
+          scripts/build-libplacebo-windows.sh
+        env:
+          LIBPLACEBO_VERSION: ${{ github.event.inputs.libplacebo_version }}
+
+      - name: Setup ffmpeg
+        run: |
+          curl -LO https://github.com/streetpea/FFmpeg-Builds/releases/download/latest/ffmpeg-n7.1-latest-win64-gpl-shared-7.1.zip
+          unzip ffmpeg-n7.1-latest-win64-gpl-shared-7.1.zip
+          cp -a "ffmpeg-n7.1-latest-win64-gpl-shared-7.1/bin/." /mingw64/bin
+          cp -a "ffmpeg-n7.1-latest-win64-gpl-shared-7.1/include/." /mingw64/include
+          cp -a "ffmpeg-n7.1-latest-win64-gpl-shared-7.1/lib/." /mingw64/lib
+
+      - name: Build sdl2-compat
+        run: |
+          INSTALL_PREFIX=/mingw64 scripts/build-sdl2-compat.sh .
+          cp /mingw64/lib/pkgconfig/sdl2-compat.pc /mingw64/lib/pkgconfig/sdl2.pc
+
+      # RelWithDebInfo rather than Release: keeps optimizations on (so timings
+      # stay representative) while retaining debug info, which is useful if
+      # you also want to point Very Sleepy/VTune/WPA at the same binary.
+      - name: Configure chiaki-ng (Tracy enabled)
+        run: |
+          cmake -S . -B build -G "Ninja" \
+            -DCMAKE_BUILD_TYPE=RelWithDebInfo \
+            -DCHIAKI_ENABLE_CLI=OFF \
+            -DCHIAKI_ENABLE_TRACY=ON
+
+      - name: Build chiaki-ng
+        run: |
+          cmake --build build --config RelWithDebInfo --clean-first --target chiaki
+
+      - name: Deploy chiaki-ng
+        run: |
+          ./scripts/deploy-windows-msys2.sh chiaki-ng-Win-Tracy build/gui/chiaki.exe "${{ github.workspace }}/build/third-party/cpp-steam-tools" /mingw64 gui/src/qml
+
+      - name: Download Tracy profiler GUI
+        run: |
+          mkdir -p chiaki-ng-Win-Tracy/tracy-tools
+          curl -L -o tracy-profiler-windows.zip "${{ github.event.inputs.tracy_profiler_zip }}"
+          # Only pull the two binaries that are actually useful here: the
+          # interactive viewer, and the headless capture-to-.tracy-file tool
+          # (handy for scripting a capture over SSH/RDP into the runner or
+          # a lab machine without needing the GUI open).
+          unzip -o tracy-profiler-windows.zip tracy-profiler.exe tracy-capture.exe -d chiaki-ng-Win-Tracy/tracy-tools
+
+      - name: Package chiaki-ng
+        run: |
+          CHIAKI_VERSION_MAJOR="$(grep 'CHIAKI_VERSION_MAJOR' CMakeLists.txt | grep -Eo '[0-9]+')"
+          CHIAKI_VERSION_MINOR="$(grep 'CHIAKI_VERSION_MINOR' CMakeLists.txt | grep -Eo '[0-9]+')"
+          CHIAKI_VERSION_PATCH="$(grep 'CHIAKI_VERSION_PATCH' CMakeLists.txt | grep -Eo '[0-9]+')"
+          RELEASE_PACKAGE_FILE="chiaki-ng-win_x64-MSYS2-Tracy-$CHIAKI_VERSION_MAJOR.$CHIAKI_VERSION_MINOR.$CHIAKI_VERSION_PATCH-${{ github.sha }}.zip"
+          zip -r $RELEASE_PACKAGE_FILE chiaki-ng-Win-Tracy
+          echo "RELEASE_PACKAGE_PATH=${RELEASE_PACKAGE_FILE}" >> $GITHUB_ENV
+
+      - name: Upload chiaki-ng Tracy-enabled Artifact
+        uses: actions/upload-artifact@v4
+        with:
+          name: chiaki-ng-win_x64-MSYS2-Tracy-portable.zip
+          path: ${{ env.RELEASE_PACKAGE_PATH }}
+          if-no-files-found: error
+          # Short retention: this is a throwaway profiling build, not a release artifact.
+          retention-days: 7
